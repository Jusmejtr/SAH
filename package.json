{
  "name": "sah",
  "version": "1.2.0",
  "description": "Steam Account Helper",
  "homepage": "https://github.com/Jusmejtr/SAH#readme",
  "bugs": {
    "url": "https://github.com/Jusmejtr/SAH/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jusmejtr/SAH.git"
  },
  "license": "ISC",
  "author": "Jusmejtr",
  "type": "module",
  "main": "dist-electron/main.js",
  "desktopName": "steam-account-helper.desktop",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:win:installer": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "electron-updater": "^6.8.9",
    "preact": "^11.0.2",
    "react-icons": "^5.7.0",
    "steam-totp": "^2.1.2",
    "steamcommunity": "^3.50.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2"
  },
  "build": {
    "appId": "com.jusmejtr.sah",
    "productName": "Steam Account Helper",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "Jusmejtr",
        "repo": "SAH"
      }
    ],
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "executableName": "steam-account-helper",
      "syncDesktopName": true,
      "synopsis": "Sign in to your Steam accounts with one click",
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Steam-Account-Helper-Setup-v${version}.${ext}"
    },
    "portable": {
      "artifactName": "Steam-Account-Helper-Portable-v${version}.${ext}"
    },
    "appImage": {
      "artifactName": "Steam-Account-Helper.${ext}"
    }
  }
}
